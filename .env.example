# Copy this file to ".env" and fill in the values. Never commit ".env".

# Port for the backend server
PORT=3001

# Both of you receive every client request (comma separated, no spaces needed)
MAIL_TO=danunjareddykota@gmail.com,nikhilrajuvadali48@gmail.com

# The mailbox the server sends FROM. For Gmail:
#  1. Turn on 2-Step Verification for that Google account.
#  2. Create an "App password" at https://myaccount.google.com/apppasswords
#  3. Paste that 16-character app password below (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-character-app-password
# Optional. Defaults to SMTP_USER.
# MAIL_FROM="FLUX <your-sending-address@gmail.com>"

# Only needed if the website is hosted at a different address than this server
# (for example the website on Netlify and this server on Render). Comma separated.
# CORS_ORIGIN=https://your-website.netlify.app

# Local testing only: set true if you get "self-signed certificate" (antivirus or college network). Never in production.
# SMTP_TLS_INSECURE=true

# Use Brevo (HTTPS) instead of SMTP on hosts that block SMTP. Sender must be verified in Brevo.
# BREVO_API_KEY=
# BREVO_SENDER=your-verified-sender@gmail.com
